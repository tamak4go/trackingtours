# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings > API).

# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only secret -- never prefix with NEXT_PUBLIC_, never commit it.
# Project Settings > API > service_role key.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Base URL used to build share links returned by the API (e.g. http://localhost:3000
# in dev, your production domain once deployed).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: origin of a self-hosted OSRM instance (see docs/self-host-osrm.md).
# Leave unset to use the public OSRM demo server (fine for testing, not for
# production traffic).
# NEXT_PUBLIC_OSRM_BASE_URL=https://osrm.yourdomain.com

# Optional: enables the "Đăng lên TikTok" button (see docs/tiktok-setup.md).
# Both come from a TikTok Developer app (developers.tiktok.com) with the
# "Content Posting API" product added. Leave unset to hide the feature --
# the button won't render without these.
# TIKTOK_CLIENT_KEY=aw...
# TIKTOK_CLIENT_SECRET=...

# Optional: enables the "Xuất chuẩn (server)" video export (see
# docs/server-video-export-setup.md) -- a separate Puppeteer+ffmpeg service
# (render-service/) deployed on its own, e.g. Render.com's free tier. Leave
# both unset to hide the button -- the two client-side export options keep
# working with no setup either way.
# RENDER_SERVICE_URL=https://trackingtours-render.onrender.com
# RENDER_SERVICE_SECRET=... (same value as RENDER_SECRET in render-service/'s own env)

# Optional: enables the "Tạo câu chuyện AI" button, which asks Gemini to
# write a short Vietnamese narrative of the trip from its route stats and a
# sample of photos (see docs/gemini-story-setup.md). Free tier, no billing
# card required. Leave unset to hide the button.
# GEMINI_API_KEY=AIza...

# Optional: enables live "lượt xem"/"thả tim" counters on the trip share page
# (see docs/firebase-setup.md). Free Spark plan, no billing card required.
# Safe to expose to the browser -- Firebase's web config is meant to be
# public; access control is enforced by Firestore security rules instead.
# Leave unset to hide the counters/like button.
# NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=...
# NEXT_PUBLIC_FIREBASE_APP_ID=1:...

# Optional: enables "Xuất ra Google Sheets" (see docs/google-sheets-export-setup.md)
# -- exports a trip's photo log using the viewer's own Google account via a
# client-side OAuth popup. Free, no billing, but does need a Google Cloud
# OAuth Client ID (separate from the Firebase project above). Leave unset to
# hide the button.
# NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=...apps.googleusercontent.com
