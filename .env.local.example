# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings > API).

# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only secret -- never prefix with NEXT_PUBLIC_, never commit it.
# Project Settings > API > service_role key.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Base URL used to build share links returned by the API (e.g. http://localhost:3000
# in dev, your production domain once deployed).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: origin of a self-hosted OSRM instance (see docs/self-host-osrm.md).
# Leave unset to use the public OSRM demo server (fine for testing, not for
# production traffic).
# NEXT_PUBLIC_OSRM_BASE_URL=https://osrm.yourdomain.com

# Optional: enables the "Đăng lên TikTok" button (see docs/tiktok-setup.md).
# Both come from a TikTok Developer app (developers.tiktok.com) with the
# "Content Posting API" product added. Leave unset to hide the feature --
# the button won't render without these.
# TIKTOK_CLIENT_KEY=aw...
# TIKTOK_CLIENT_SECRET=...

# Optional: enables the "Xuất chuẩn (server)" video export (see
# docs/server-video-export-setup.md) -- a separate Puppeteer+ffmpeg service
# (render-service/) deployed on its own, e.g. Render.com's free tier. Leave
# both unset to hide the button -- the two client-side export options keep
# working with no setup either way.
# RENDER_SERVICE_URL=https://trackingtours-render.onrender.com
# RENDER_SERVICE_SECRET=... (same value as RENDER_SECRET in render-service/'s own env)
