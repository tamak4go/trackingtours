# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings > API).

# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only secret -- never prefix with NEXT_PUBLIC_, never commit it.
# Project Settings > API > service_role key.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Base URL used to build share links returned by the API (e.g. http://localhost:3000
# in dev, your production domain once deployed).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
